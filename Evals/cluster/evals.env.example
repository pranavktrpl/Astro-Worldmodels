# Cluster eval configuration.
# Copy to evals.env (same directory, gitignored) and edit for your machine:
#   cp Evals/cluster/evals.env.example Evals/cluster/evals.env

# Repo clone on the cluster
REPO_DIR="$HOME/Astro-Worldmodels"

# Conda: env name plus the conda.sh that makes `conda activate` work in scripts.
# To bypass conda entirely, set PYTHON to an interpreter path instead —
# it takes precedence over the two conda settings.
CONDA_ENV="lejepa-og"
CONDA_SH="$HOME/miniconda3/etc/profile.d/conda.sh"
#PYTHON="/mnt/ssd-cluster/pranav/conda/envs/lejepa-og/bin/python"

# Galaxy10 HDF5 location (symlinked into the repo path the evals expect)
GALAXY10_H5="/mnt/data/astro-worldmodels/galaxy10/Galaxy10_DECals.h5"

# Checkpoint sources (optional). If set, each is symlinked into the fixed
# repo-relative path the eval scripts expect (checkpoints/<family>/step_*.pt).
# Leave empty/commented if the files are already under $REPO_DIR/checkpoints/.
#CKPT_LARGE_SRC="/mnt/ssd-cluster/pranav/Astro-Worldmodels/checkpoints/VitLargePatch14_OfficialTrain5_Epoch5_2504/step_52000.pt"
#CKPT_SMALL_SRC="/mnt/ssd-cluster/pranav/Astro-Worldmodels/checkpoints/VitSmallPatch14_2204/step_21000.pt"

# Which recommended checkpoints to evaluate: all | large | small.
# Set to large/small if only one checkpoint is present on this machine.
MODELS="all"

DEVICE="cuda"
TMUX_SESSION="evals"
LOG_DIR="$REPO_DIR/logs/cluster_evals"
