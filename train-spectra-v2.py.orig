@dataclass
class SpectraTrainConfig(TrainConfig):
    model_name: str = "astrojepa_spectra_desi_v2_global_local_lejepa"
    pretrained_backbone: bool = False

    # Read directly from the external read-only dataset tree; no spectra are copied into this repository.
    dataset_name: str = "/mnt/datasets/utbd_pranav/desi_edr_sv3/mmu_desi_edr_sv3/dataset"
    columns: list[str] = None
    spectra_dataset_name: str = "/mnt/datasets/utbd_pranav/desi_edr_sv3/mmu_desi_edr_sv3/dataset"
    spectra_columns: list[str] = None
    raw_num_spectra: int = 1_126_441
    train_num_spectra: int = 1_103_874
    audited_default_steps_per_epoch: int = 17_239
    split_seed: int = 42

    spectra_num_pixels: int = 7781
    spectra_patch_size: int = 20
    spectra_num_patches: int = 389
    spectra_num_views: int = 2
    spectra_mask_ratio: float = 0.30
    spectra_mask_span: tuple[int, int] = (2, 12)
    spectra_disjoint_view_masks: bool = True
    spectra_min_valid_patch_fraction: float = 0.50
    spectra_noise_scale: float = 0.50
    spectra_max_normalized_noise_std: float = 3.0

    spectra_embed_dim: int = 768
    spectra_depth: int = 12
    spectra_num_heads: int = 12
    spectra_mlp_ratio: float = 4.0
    spectra_dropout: float = 0.0
    spectra_pooling: str = "cls"
    spectra_local_proj_dim: int = 64

    bs: int = 16
    num_workers: int = 4
    # Global shuffle target. build_train_loader divides this across every DDP
    # rank and DataLoader worker so each worker does not allocate 50k samples.
    shuffle_buffer_size: int = 50_000
    dataloader_timeout_seconds: int = 1_800
    data_sharding_strategy: str = "balanced_files_per_rank_hf_workers"

    Vg: int = 2
    Vl: int = 0
    lambd: float = 0.05
    local_lambd: float = 0.05
    local_loss_weight: float = 1.0
    local_sigreg_num_points: int = 17
    local_sigreg_num_slices: int = 256
    local_sigreg_num_positions: int = 32
    grad_clip_norm: float = 1.0

    epochs: int = 10
    max_steps: int | None = None

    project: str = "astrojepa"
    run_name: str = "SpectraV2_DESI_GlobalLocalLeJEPA_MeanStd_CorrectedEpochs"
    save_dir: str = "./checkpoints/SpectraV2_DESI_GlobalLocalLeJEPA_MeanStd_CorrectedEpochs"
    resume_path: str | None = None
    wandb_run_id: str | None = None
    wandb_resume: str = "allow"
    wandb_mode: str = "online"
    keep_last_periodic_checkpoints: int = 2

    def __post_init__(self):
        if self.columns is None:
            self.columns = ["spectrum", "object_id"]
        if self.spectra_columns is None:
            self.spectra_columns = ["spectrum", "object_id"]


def parse_args():
    parser = argparse.ArgumentParser(description="Train the DESI spectrum v2 LeJEPA backbone")
    parser.add_argument("--epochs", type=int)
    parser.add_argument("--max-steps", type=int)
    parser.add_argument("--batch-size", type=int)
    parser.add_argument("--num-workers", type=int)
    parser.add_argument("--run-name")
    parser.add_argument("--save-dir")
    parser.add_argument("--resume")
    parser.add_argument("--wandb-mode", choices=("online", "offline", "disabled"))
    return parser.parse_args()


def apply_cli_overrides(cfg, args):
    overrides = {
        "epochs": args.epochs,
        "max_steps": args.max_steps,
        "bs": args.batch_size,
        "num_workers": args.num_workers,
        "run_name": args.run_name,
        "save_dir": args.save_dir,
        "resume_path": args.resume,
        "wandb_mode": args.wandb_mode,
    }
    for name, value in overrides.items():
        if value is not None:
            setattr(cfg, name, value)
    return cfg


######################################################### fast paths #########################################################
torch.backends.cudnn.benchmark = True
torch.backends.cuda.matmul.allow_tf32 = True
torch.set_float32_matmul_precision("high")


######################################################### DDP Setup + Dataloading #########################################################
def setup_ddp():
    dist.init_process_group(
        backend="nccl",
        timeout=timedelta(minutes=60),
    )

    world_size = dist.get_world_size()
    rank = dist.get_rank()   #Which process this is globally, so rank is an init in the dataset object we created, cause every GPU gets a custom dataset object
    local_rank = int(os.environ["LOCAL_RANK"])  #Just which GPU this is on the node, same as rank, no need honestly

    torch.cuda.set_device(local_rank)  #Binds the process to the GPU, for if we stop mid way, and we want to resume, the process no is not mixed and we stick to same GPU always
    device = torch.device("cuda", local_rank)

    return world_size, rank, local_rank, device

def seed_everything(seed, rank):
    seed = seed + rank
    random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)

def is_main_process(rank):
    return rank == 0         #So we log only one main process, not all
    
def build_train_loader(cfg, world_size, rank):
    workers_per_rank = max(1, cfg.num_workers)
    total_readers = world_size * workers_per_rank
    per_worker_shuffle_buffer_size = max(
        1,
        (cfg.shuffle_buffer_size + total_readers - 1) // total_readers,
    )
    train_ds = DesiSpectraDataset(
        split="train",
        dataset=cfg.spectra_dataset_name,
        columns=cfg.spectra_columns,
        shuffle=True,
        world_size=world_size,
        rank=rank,
        num_views=cfg.spectra_num_views,
        patch_size=cfg.spectra_patch_size,
        expected_num_pixels=cfg.spectra_num_pixels,
        mask_ratio=cfg.spectra_mask_ratio,
        mask_span=cfg.spectra_mask_span,
        disjoint_view_masks=cfg.spectra_disjoint_view_masks,
        min_valid_patch_fraction=cfg.spectra_min_valid_patch_fraction,
        noise_scale=cfg.spectra_noise_scale,
        max_normalized_noise_std=cfg.spectra_max_normalized_noise_std,
        split_seed=cfg.split_seed,
        shuffle_buffer_size=per_worker_shuffle_buffer_size,
        loader_num_workers=workers_per_rank,
    )
    train_loader = DataLoader(
        train_ds,
        batch_size=cfg.bs,
        num_workers=cfg.num_workers,
        pin_memory=True,
        # Workers must be recreated so train_ds.set_epoch() reaches their dataset copies.
        persistent_workers=False,
        prefetch_factor=2 if cfg.num_workers > 0 else None,
        timeout=cfg.dataloader_timeout_seconds if cfg.num_workers > 0 else 0,
        drop_last=True,
    )
    return train_ds, train_loader

