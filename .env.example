# Copy to .env (repo root, gitignored) and fill in. Both train-vision.py and
# train-spectra.py call load_dotenv(), so these become process env vars.

# wandb.init picks this up automatically — get yours at
# https://wandb.ai/authorize
WANDB_API_KEY=

# Optional: wandb entity (team or username) for continued-pretraining runs.
# Leave empty to log to your API key's default entity.
WANDB_ENTITY=

# Optional: override the wandb project for continued-pretraining runs.
#WANDB_PROJECT=astrojepa
